# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ivac_license?schema=public"

# Admin Authentication & Security
ADMIN_JWT_SECRET="replace-with-a-very-secure-random-secret-key-at-least-32-chars"
ADMIN_SESSION_TTL_HOURS=24

# Initial Admin Seed (used for first-time automated setup or CLI seed)
INITIAL_ADMIN_EMAIL="admin@ivac-automation.com"
INITIAL_ADMIN_USERNAME="superadmin"
INITIAL_ADMIN_PASSWORD="ChangeThisStrongPassword123!"

# CORS Configuration (comma-separated list of allowed origins)
# Include chrome-extension://<id> for the extension and the admin frontend origin
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
